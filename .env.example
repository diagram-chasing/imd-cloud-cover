# Public URL of the Cloudflare R2 bucket serving the pipeline's JSON views.
# Leave unset in dev to use the committed static/sample fixtures.
VITE_R2_PUBLIC_URL=https://your-bucket.example.com

# Base URL of the licensed Ships Whistle webfonts in R2 (the bucket's public
# custom domain / r2.dev URL + the Ships-Whistle prefix). Required to build:
# scripts/fetch-fonts.mjs pulls the woff2/woff cuts into src/lib/assets/fonts/.
FONTS_URL=https://your-fonts-domain.example.com/Ships-Whistle
