{
	"name": "imd-meteograms",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.5.2",
	"scripts": {
		"dev": "node scripts/fetch-fonts.mjs && node scripts/bake-data.mjs --if-stale --core-only && vite dev",
		"fonts": "node scripts/fetch-fonts.mjs --force",
		"bake": "node scripts/bake-data.mjs",
		"bake:ground": "node scripts/bake-ground.mjs",
		"og": "node scripts/build-og.mjs",
		"build": "node scripts/fetch-fonts.mjs && node scripts/bake-data.mjs && node scripts/build-og.mjs && vite build && node scripts/inject-preloads.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@fontsource-variable/inter": "^5.2.8",
